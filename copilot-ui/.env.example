# =============================================================================
# Dev local — copier ce fichier en `copilot-ui/.env` puis relancer `npm run dev`
# Vite charge UNIQUEMENT les .env depuis le dossier `copilot-ui/` (pas la racine).
# =============================================================================

# Cible du proxy Vite : `/webhook/*` et `/api/*` → cette origine n8n
# Par défaut (si absent) : https://n8nprod.aphelionxinnovations.com
VITE_N8N_PROXY_TARGET=https://n8nprod.aphelionxinnovations.com

# Appels directs n8n en dev (URLs absolues https://n8nprod…/webhook/… au lieu de :5173/webhook)
# CORS doit être activé sur n8n pour votre origine locale.
VITE_N8N_DIRECT_IN_DEV=1
VITE_N8N_BASE_URL=https://n8nprod.aphelionxinnovations.com

# Alternative si vous avez n8n en local :
# VITE_N8N_PROXY_TARGET=http://localhost:5678

# Debug proxy dans le terminal Vite (proxy:req / proxy:error)
# VITE_PROXY_DEBUG=1

# WF_Manager_Conversations — PATCH archivage (wmc-archive-v1, placeholder {id})
# VITE_N8N_WEBHOOK_CONV_ARCHIVE=/webhook/wmc-archive-v1/manager/conversations/{id}/archive
# WF_Manager_Conversations — GET détail (wmc-detail-v1, placeholder {id})
# VITE_N8N_WEBHOOK_CONV_DETAIL=/webhook/wmc-detail-v1/manager/conversations/{id}

# PATCH projet (modal « Modifier le projet » + description Vue d'ensemble)
# Défaut : /webhook/wmp-update-v1/manager/projects/{id}
# Corps : { status, priority, milestone_at } ou { description }
# VITE_WMP_UPDATE_PROJECTS_PREFIX=/webhook/wmp-update-v1/manager/projects
# VITE_MANAGER_PROJECTS_UPDATE_URL=/webhook/wmp-update-v1/manager/projects/:id

# Auth (chemins relatifs — passent par le proxy ci-dessus)
VITE_API_LOGIN=/webhook/login
VITE_API_REFRESH=/webhook/refresh
VITE_API_LOGOUT=/webhook/logout
VITE_API_ME=/webhook/me
# Mot de passe oublié / réinitialisation (proxy /webhook → n8n)
# POST /webhook/auth/forgot-password
# POST /webhook/auth/reset-password

# Compte RH démo (optionnel)
# VITE_RH_EMAIL=rh@demo.com

# WF_RH_Users_Management — comptes manager/RH
# POST/GET  /webhook/rh/users
# PATCH     /webhook/wf-rh-users-patch-v1/rh/users/{id}
# DELETE    /webhook/wf-rh-users-delete-v1/rh/users/{id}

# WF_RH_Talent_Portal_Access — accès portail
# POST onboard   https://n8nprod.aphelionxinnovations.com/webhook/rh/talents/onboard
# POST grant     …/webhook/wf-rh-talent-grant-v1/rh/talents/{id}/grant-access  body: { password } UNIQUEMENT
# GET unlinked   …/webhook/rh/talents/unlinked
# VITE_N8N_API_BASE=  (vide en dev → proxy Vite ; prod build = URL absolue auto)
# Dev : requêtes /webhook/* → proxy Vite → https://n8nprod.aphelionxinnovations.com
# Prod build : API_BASE = https://n8nprod.aphelionxinnovations.com

# WF_RH_Talents_Profile_CRUD — profils talents
# POST/GET  https://n8nprod.aphelionxinnovations.com/webhook/rh/accounts/talent
# PATCH     …/webhook/wf-rh-talent-patch-v1/rh/accounts/talent/{id}  (body vide)
# DELETE    …/webhook/wf-rh-talent-delete-v1/rh/accounts/talent/{id}
# Dev : laisser VITE_N8N_API_BASE vide (défaut) → URLs relatives /webhook/* via proxy Vite (pas de CORS).
# Prod build : API_BASE = https://n8nprod.aphelionxinnovations.com automatiquement.
# Forcer URL absolue en dev (CORS requis côté n8n) : décommenter la ligne ci-dessous.
# VITE_N8N_API_BASE=https://n8nprod.aphelionxinnovations.com

# WF_RH_Talents_Profile_CRUD — profils talents
# GET       /webhook/rh/accounts/talent
# POST      /webhook/rh/accounts/talent  (création fiche compte talent)
# PATCH     /webhook/wf-rh-talent-patch-v1/rh/accounts/talent/{id}
# DELETE    /webhook/wf-rh-talent-delete-v1/rh/accounts/talent/{id}
#
# Portail talent (dialog « Donner accès »)
# POST onboard (nouveau)     /webhook/rh/talents/onboard
# POST grant-access (existant) /webhook/wf-rh-talent-grant-v1/rh/talents/{id}/grant-access  body: { password }
# GET unlinked               /webhook/rh/talents/unlinked
# VITE_API_RH_TALENT_GRANT_ACCESS_BASE=/webhook/wf-rh-talent-grant-v1/rh/talents/{id}/grant-access
# VITE_N8N_API_BASE=https://n8nprod.aphelionxinnovations.com
# VITE_API_RH_ACCOUNTS_TALENT=/webhook/rh/accounts/talent
# VITE_API_RH_TALENT_PATCH_BASE=/webhook/wf-rh-talent-patch-v1/rh/accounts/talent
# VITE_API_RH_TALENT_DELETE_BASE=/webhook/wf-rh-talent-delete-v1/rh/accounts/talent

# WF_RH_Project_Budget_v1 — budget RH par projet (dev : proxy /webhook → n8nprod)
# VITE_RH_BUDGET_LIST_URL=/webhook/rh/projects/budget
# VITE_RH_BUDGET_DETAIL_URL=/webhook/rh/projects/budget/detail
# VITE_RH_BUDGET_ENVELOPE_URL=/webhook/rh/projects/budget/envelope
# VITE_RH_BUDGET_HISTORY_URL=/webhook/rh/projects/budget/history
# VITE_RH_BUDGET_SUMMARY_URL=/webhook/rh/projects/budget/summary

# WF_RH_Risks_Watchdog_v1 — Risques RH (proxy dev → n8nprod)
# VITE_RH_RISKS_LIST_URL=/webhook/rh/risks
# VITE_RH_RISKS_SUMMARY_URL=/webhook/rh/risks/summary
# VITE_RH_RISKS_TALENT_URL=/webhook/wf-rh-risks-talent-v1/rh/risks/talent
# VITE_RH_RISKS_CREATE_ACTION_URL=/webhook/rh/risks/create-action
# Prod (URLs absolues) :
# VITE_RH_RISKS_LIST_URL=https://n8nprod.aphelionxinnovations.com/webhook/rh/risks
# VITE_RH_RISKS_SUMMARY_URL=https://n8nprod.aphelionxinnovations.com/webhook/rh/risks/summary
# VITE_RH_RISKS_TALENT_URL=https://n8nprod.aphelionxinnovations.com/webhook/wf-rh-risks-talent-v1/rh/risks/talent
# VITE_RH_RISKS_CREATE_ACTION_URL=https://n8nprod.aphelionxinnovations.com/webhook/rh/risks/create-action

# WF_RH_Assignments_v2 — Mobilité RH
# LIST   GET  /webhook/rh/assignments
# CREATE POST /webhook/rh/assignments
# PATCH       /webhook/wf-rh-assignments-update-v2/rh/assignments/{id}
# DELETE      /webhook/wf-rh-assignments-delete-v2/rh/assignments/{id}
# VITE_RH_ASSIGNMENTS_LIST_WEBHOOK_PREFIX=/webhook/rh/assignments
# VITE_RH_ASSIGNMENTS_CREATE_WEBHOOK_PREFIX=/webhook/rh/assignments

# DELETE affectation RH (Mobilité) — surcharge optionnelle
# VITE_RH_ASSIGNMENTS_DELETE_WEBHOOK_PREFIX=/webhook/wf-rh-assignments-delete-v2/rh/assignments
# Fallback legacy v1 si besoin :
# VITE_RH_ASSIGNMENTS_DELETE_WEBHOOK_PREFIX=/webhook/rh/assignments

# WF_Talent_Projects — détail projet (drawer Mes projets)
# Défaut : /webhook/wf-talent-projects-detail-v1/talent/projects/{id}
# VITE_TALENT_PROJECTS_DETAIL_PREFIX=/webhook/wf-talent-projects-detail-v1/talent/projects
# VITE_TALENT_PROJECTS_DETAIL_URL=/webhook/wf-talent-projects-detail-v1/talent/projects/:id

# WF_Talent_Skills — PATCH mise à jour compétence (drawer Mes compétences)
# Défaut : /webhook/wf-talent-skills-update-v1/talent/skills/{id}
# VITE_TALENT_SKILLS_UPDATE_PREFIX=/webhook/wf-talent-skills-update-v1/talent/skills
# VITE_TALENT_SKILLS_UPDATE_URL=/webhook/wf-talent-skills-update-v1/talent/skills/:id

# WF_Talent_Skills — DELETE suppression compétence
# Défaut : /webhook/wf-talent-skills-delete-v1/talent/skills/{id}
# VITE_TALENT_SKILLS_DELETE_PREFIX=/webhook/wf-talent-skills-delete-v1/talent/skills
# VITE_TALENT_SKILLS_DELETE_URL=/webhook/wf-talent-skills-delete-v1/talent/skills/:id

# WF_Talent_Opportunities — GET détail (drawer Mes opportunités)
# Défaut : /webhook/wf-talent-opp-detail-v1/talent/opportunities/{id}
# VITE_TALENT_OPPORTUNITIES_DETAIL_PREFIX=/webhook/wf-talent-opp-detail-v1/talent/opportunities
# VITE_TALENT_OPPORTUNITIES_DETAIL_URL=/webhook/wf-talent-opp-detail-v1/talent/opportunities/:id

# WF_Talent_Opportunities — POST intérêt
# Défaut : /webhook/wf-talent-opp-interest-v1/talent/opportunities/{id}/interest
# VITE_TALENT_OPPORTUNITIES_INTEREST_PREFIX=/webhook/wf-talent-opp-interest-v1/talent/opportunities
# VITE_TALENT_OPPORTUNITIES_INTEREST_URL=/webhook/wf-talent-opp-interest-v1/talent/opportunities/:id/interest

# WF_Talent_Notifications — PATCH marquer une notification lue
# Défaut : /webhook/wf-talent-notif-read-v1/talent/notifications/{id}/read
# VITE_TALENT_NOTIFICATIONS_READ_PREFIX=/webhook/wf-talent-notif-read-v1/talent/notifications
# VITE_TALENT_NOTIFICATIONS_READ_URL=/webhook/wf-talent-notif-read-v1/talent/notifications/:id/read
# read-all (collection) : /webhook/talent/notifications/read-all

# WF_Talent_Chat — collection sessions (liste + création)
# GET/POST : /webhook/talent/chat/sessions

# WF_Talent_Chat — GET détail session + messages
# Défaut : /webhook/wf-talent-chat-detail-v1/talent/chat/sessions/{id}
# VITE_TALENT_CHAT_DETAIL_PREFIX=/webhook/wf-talent-chat-detail-v1/talent/chat/sessions
# VITE_TALENT_CHAT_DETAIL_URL=/webhook/wf-talent-chat-detail-v1/talent/chat/sessions/:id

# WF_Talent_Chat — POST message
# Défaut : /webhook/wf-talent-chat-message-v1/talent/chat/sessions/{id}/message
# VITE_TALENT_CHAT_MESSAGE_PREFIX=/webhook/wf-talent-chat-message-v1/talent/chat/sessions
# VITE_TALENT_CHAT_MESSAGE_URL=/webhook/wf-talent-chat-message-v1/talent/chat/sessions/:id/message

# WF_Talent_Chat — DELETE session
# Défaut : /webhook/wf-talent-chat-delete-v1/talent/chat/sessions/{id}
# VITE_TALENT_CHAT_DELETE_PREFIX=/webhook/wf-talent-chat-delete-v1/talent/chat/sessions
# VITE_TALENT_CHAT_DELETE_URL=/webhook/wf-talent-chat-delete-v1/talent/chat/sessions/:id

# WF_Strategic_Orchestrator_Recompute_v1 — relance compute multi-projets (dashboard Matchmaker)
# POST /webhook/api/orchestrator/recompute — body { scope: "all_my_projects" | "project", project_id? }
# Réponse 202 ; résultats lus ensuite via GET /webhook/manager/dashboard (JWT via proxy dev)

# ─────────────────────────────────────────────────────────
# API n8n manager — overrides optionnels (défauts dans src/lib/api-routes.ts)
# ─────────────────────────────────────────────────────────

# Base prod (build) — dev : laisser vide, proxy Vite `/webhook` → n8nprod
# VITE_API_BASE_URL=https://n8nprod.aphelionxinnovations.com/webhook

# Projects core
# VITE_WMP_DETAIL_PREFIX=/webhook/wmp-detail-v1/manager
# VITE_WMP_DETAIL_PROJECTS_PREFIX=/webhook/wmp-detail-v1/manager/projects
# VITE_WMP_UPDATE_PREFIX=/webhook/wmp-update-v1/manager
# VITE_WMP_UPDATE_PROJECTS_PREFIX=/webhook/wmp-update-v1/manager/projects
# VITE_WMP_DELETE_PREFIX=/webhook/wmp-delete-v1/manager
# VITE_WMP_DELETE_PROJECTS_PREFIX=/webhook/wmp-delete-v1/manager/projects
# VITE_WMP_ASSIGN_PREFIX=/webhook/wmp-assign-v1/manager/projects
# VITE_WMP_UNASSIGN_PREFIX=/webhook/wmp-unassign-v1/manager/projects

# Budget
# VITE_MGR_BUDGET_GET_PREFIX=/webhook/mgr-budget-get/manager/projects
# VITE_MGR_BUDGET_PATCH_PREFIX=/webhook/mgr-budget-patch/manager/projects
# VITE_MGR_BUDGET_RESET_PREFIX=/webhook/mgr-budget-reset/manager/projects
# VITE_MGR_BUDGET_HISTORY_PREFIX=/webhook/mgr-budget-history/manager/projects

# Tasks
# VITE_WMT_LIST_PREFIX=/webhook/wmt-list-v1/manager/projects
# VITE_WMT_CREATE_PREFIX=/webhook/wmt-create-v1/manager/projects
# VITE_WMT_UPDATE_PREFIX=/webhook/wmt-update-v1/manager/projects
# VITE_WMT_COMPLETE_PREFIX=/webhook/wmt-complete-v1/manager/projects
# VITE_WMT_DELETE_PREFIX=/webhook/wmt-delete-v1/manager/projects

# Requirements
# VITE_MGR_PR_REQ_LIST_PREFIX=/webhook/wf-mgr-pr-req-list/manager/projects
# VITE_MGR_PR_REQ_CREATE_PREFIX=/webhook/wf-mgr-pr-req-create/manager/projects
# VITE_MGR_PR_REQ_UPDATE_PREFIX=/webhook/wf-mgr-pr-req-update/manager/projects
# VITE_MGR_PR_REQ_DELETE_PREFIX=/webhook/wf-mgr-pr-req-delete/manager/projects

# Team
# VITE_WMT_DETAIL_PREFIX=/webhook/wmt-detail-v1/manager/team

# Risks
# VITE_WMN_ALERT_PREFIX=/webhook/wmn-alert-v3/manager/risk-alerts

# Copilot conversations — voir aussi VITE_N8N_WEBHOOK_CONV_* en tête de fichier

# Skills catalog RH
# VITE_RH_SKILLS_CATALOG_URL=/webhook/rh/skills/catalog
