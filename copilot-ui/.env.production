# Même origine que le site Vercel : le navigateur appelle /webhook/… puis Vercel relaie vers n8n (voir vercel.json à la racine).
# Évite CORS « Failed to fetch » par rapport aux URL https:// n8n directes.

VITE_API_LOGIN=/webhook/login
VITE_API_REFRESH=/webhook/refresh
VITE_API_LOGOUT=/webhook/logout
VITE_API_ME=/webhook/me

VITE_API_RH_USERS_LIST=/webhook/rh/users
VITE_API_RH_USERS_CREATE=/webhook/rh/users
VITE_API_RH_USERS_ROLE=/webhook/rh/users/role
VITE_API_RH_USERS_STATUS=/webhook/rh/users/status
VITE_API_RH_USERS_PASSWORD_RESET_BASE=/webhook/rh/users
VITE_API_RH_SESSIONS=/webhook/rh/sessions

# WF_RH_Talents_Delete_v1 — DELETE soft delete talent
VITE_RH_TALENT_DELETE_WEBHOOK_PREFIX=/webhook/wf-rh-talents-delete-v1/rh/talents

# WF_RH_Talents_Update_v1 — PATCH modification talent
VITE_RH_TALENT_UPDATE_WEBHOOK_PREFIX=/webhook/wf-rh-talents-update-v1/rh/talents

# WF_RH_Employment — GET/PUT (webhookId n8n production, placeholder {id} = UUID talent)
VITE_RH_EMPLOYMENT_GET_URL=/webhook/c8636463-8c45-4aa9-a9f0-8d0103866ead/rh/talents/{id}/employment
VITE_RH_EMPLOYMENT_PUT_URL=/webhook/22ddf7e2-6de0-4cbf-8160-66fabc1a0197/rh/talents/{id}/employment

# WF_RH Skills — surcharge optionnelle du GET uniquement (ADD/UPDATE/DELETE : slugs dédiés dans le code)
VITE_RH_SKILLS_BASE_URL=https://n8nprod.aphelionxinnovations.com/webhook/wf-rh-skills-get-v1

# WF_RH_Skills_Management — GET /rh/skills/catalog (webhookId = Production URL n8n)
# VITE_RH_SKILLS_CATALOG_URL=/webhook/<webhookId>/rh/skills/catalog

# RH Absences — Production URLs n8n (Vercel relaie /webhook → n8nprod)
VITE_RH_ABSENCES_GET_URL=/webhook/8bdca4ee-7008-42aa-9824-adc4a2e3fcd7/rh/talents/{id}/absences
VITE_RH_ABSENCES_POST_URL=/webhook/7a1febf8-c503-4d33-b7a8-1178372fd8f5/rh/talents/{id}/absences
VITE_RH_ABSENCES_DELETE_URL=/webhook/c946d940-a739-4130-9ea7-6d6f6224b2c7/rh/absences/{id}
VITE_RH_ABSENCES_CURRENT_URL=/webhook/rh/absences/current

# WF_RH_Matching_Run — https://n8nprod.aphelionxinnovations.com/webhook/rh/matching
VITE_RH_MATCHING_RUN_URL=https://n8nprod.aphelionxinnovations.com/webhook/rh/matching
VITE_RH_MATCHING_RESULTS_URL=https://n8nprod.aphelionxinnovations.com/webhook/rh/matching/results
VITE_RH_MATCHING_PROJECTS_URL=https://n8nprod.aphelionxinnovations.com/webhook/rh/matching/projects

# WF_Manager_RH_Actions (manager uniquement — création / annulation)
VITE_RH_ACTIONS_URL=https://n8nprod.aphelionxinnovations.com/webhook/api/rh/actions
VITE_RH_ACTIONS_PATCH_URL=https://n8nprod.aphelionxinnovations.com/webhook/c8bae94d-8de1-4f06-bb0a-a1e90eb6a80d/api/rh/actions

# WF_RH_Requests_Decision (rôle RH — consultation + décision)
VITE_RH_REQUESTS_URL=/webhook/rh/requests

# WF_Manager_Conversations — PATCH archivage logique (wmc-archive-v1)
VITE_N8N_WEBHOOK_CONV_ARCHIVE=/webhook/wmc-archive-v1/manager/conversations/{id}/archive

# Optionnel — upload de photo de profil (Supabase Storage, bucket public « avatars »).
# En local, copie ces lignes dans `.env` (à la racine de copilot-ui) avec tes valeurs projet Supabase.
# VITE_SUPABASE_URL=https://hpjeczkhzcecmtwaapcr.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
