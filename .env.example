# E-mail du compte RH (démo locale, optionnel). Ce compte reçoit le rôle « rh ».
# Rétrocompat : VITE_ADMIN_EMAIL est encore lu comme alias.
# Exemple : VITE_RH_EMAIL=rh@exemple.com
VITE_RH_EMAIL=
# VITE_ADMIN_EMAIL=

# Supabase Storage — bucket public « avatars » (clé publishable / anon uniquement, jamais sb_secret_…)
# Fichier local : copilot-ui/.env
# Fichier effectif : copilot-ui/.env (chargé par Vite)
# VITE_SUPABASE_URL=https://hpjeczkhzcecmtwaapcr.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...  (jamais sb_secret_…)

# WF_RH_Talents_Delete_v1 — désactivation talent RH (copilot-ui/.env)
# VITE_RH_TALENT_DELETE_WEBHOOK_PREFIX=/webhook/wf-rh-talents-delete-v1/rh/talents
# VITE_RH_TALENT_UPDATE_WEBHOOK_PREFIX=/webhook/wf-rh-talents-update-v1/rh/talents

# RH Absences — Production URLs n8n
# VITE_RH_ABSENCES_GET_URL=https://n8nprod.aphelionxinnovations.com/webhook/8bdca4ee-7008-42aa-9824-adc4a2e3fcd7/rh/talents/{id}/absences
# VITE_RH_ABSENCES_POST_URL=https://n8nprod.aphelionxinnovations.com/webhook/7a1febf8-c503-4d33-b7a8-1178372fd8f5/rh/talents/{id}/absences
# VITE_RH_ABSENCES_DELETE_URL=https://n8nprod.aphelionxinnovations.com/webhook/c946d940-a739-4130-9ea7-6d6f6224b2c7/rh/absences/{id}
# VITE_RH_ABSENCES_CURRENT_URL=https://n8nprod.aphelionxinnovations.com/webhook/rh/absences/current

# WF_RH_Matching_Run — Workforce Arbitration (production : /webhook/, jamais /webhook-test/)
# VITE_RH_MATCHING_RUN_URL=/webhook/rh/matching
# VITE_RH_MATCHING_RESULTS_URL=/webhook/rh/matching/results
# VITE_RH_MATCHING_PROJECTS_URL=/webhook/rh/matching/projects
# VITE_RH_MATCHING_RUN_URL=https://n8nprod.aphelionxinnovations.com/webhook/rh/matching
# VITE_RH_MATCHING_RESULTS_URL=https://n8nprod.aphelionxinnovations.com/webhook/rh/matching/results
# VITE_RH_MATCHING_PROJECTS_URL=https://n8nprod.aphelionxinnovations.com/webhook/rh/matching/projects

# WF_RH_Skills_Management — GET catalogue (Production URL n8n, node GET /rh/skills/catalog)
# VITE_RH_SKILLS_CATALOG_URL=/webhook/<webhookId>/rh/skills/catalog
# VITE_RH_SKILLS_CATALOG_URL=https://n8nprod.aphelionxinnovations.com/webhook/<webhookId>/rh/skills/catalog

# WF_RH_Employment — GET/PUT avec webhookId n8n (placeholder {id} = UUID talent, jamais POST)
# En local via proxy Vite : chemins relatifs /webhook/{uuid}/rh/talents/{id}/employment
# VITE_RH_EMPLOYMENT_GET_URL=/webhook/c8636463-8c45-4aa9-a9f0-8d0103866ead/rh/talents/{id}/employment
# VITE_RH_EMPLOYMENT_PUT_URL=/webhook/22ddf7e2-6de0-4cbf-8160-66fabc1a0197/rh/talents/{id}/employment
# Ou URLs absolues production :
# VITE_RH_EMPLOYMENT_GET_URL=https://n8nprod.aphelionxinnovations.com/webhook/c8636463-8c45-4aa9-a9f0-8d0103866ead/rh/talents/{id}/employment
# VITE_RH_EMPLOYMENT_PUT_URL=https://n8nprod.aphelionxinnovations.com/webhook/22ddf7e2-6de0-4cbf-8160-66fabc1a0197/rh/talents/{id}/employment
# WF_Manager_RH_Actions — GET/POST /webhook/api/rh/actions · PATCH /webhook/c8bae94d-…/api/rh/actions/:id
# VITE_RH_ACTIONS_URL=/webhook/api/rh/actions
# VITE_RH_ACTIONS_PATCH_URL=/webhook/c8bae94d-8de1-4f06-bb0a-a1e90eb6a80d/api/rh/actions
# VITE_RH_ACTIONS_URL=https://n8nprod.aphelionxinnovations.com/webhook/api/rh/actions
# VITE_RH_ACTIONS_PATCH_URL=https://n8nprod.aphelionxinnovations.com/webhook/c8bae94d-8de1-4f06-bb0a-a1e90eb6a80d/api/rh/actions
# Activer la liste actions sur les pages dédiées (désactivé sur le dashboard / nav RH)
# VITE_RH_ACTIONS_ENABLED=1
